---
interface Props {
  url: string;
  author: string;
  handle: string;
  date: string;
  translation?: string;
  linkLabel?: string;
}
const { url, author, handle, date, translation, linkLabel = 'X에서 원문 보기' } = Astro.props;
---

<figure class="x-embed">
  <div class="x-embed-header">
    <span class="x-embed-author">
      <span class="x-embed-name">{author}</span>
      <span class="x-embed-handle">@{handle} · {date}</span>
    </span>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="x-embed-logo" aria-label="X"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
  </div>
  <blockquote class="x-embed-text"><slot /></blockquote>
  {translation && <p class="x-embed-translation">{translation}</p>}
  <a href={url} target="_blank" rel="noopener noreferrer" class="x-embed-link">{linkLabel} →</a>
</figure>

<style>
  .x-embed {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #f9fafb;
  }
  .x-embed-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .x-embed-name {
    font-weight: 700;
    font-size: 0.9375rem;
    color: #111827;
  }
  .x-embed-handle {
    margin-left: 0.375rem;
    font-size: 0.8125rem;
    color: #9ca3af;
  }
  .x-embed-logo {
    flex-shrink: 0;
    margin-top: 0.125rem;
    color: #9ca3af;
  }
  .x-embed-text {
    margin: 0.625rem 0 0;
    padding: 0;
    border: none;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #1f2937;
    font-style: normal;
  }
  .x-embed-text :global(p) {
    margin: 0 0 0.5rem;
  }
  .x-embed-text :global(p:last-child) {
    margin-bottom: 0;
  }
  .x-embed-translation {
    margin: 0.75rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px dashed #e5e7eb;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #6b7280;
  }
  .x-embed-link {
    display: inline-block;
    margin-top: 0.625rem;
    font-size: 0.75rem;
    color: #9ca3af;
    text-decoration: none;
  }
  .x-embed-link:hover {
    color: var(--color-primary-600, #0284c7);
  }
  @media (prefers-color-scheme: dark) {
    .x-embed {
      border-color: #374151;
      background: #1f2937;
    }
    .x-embed-name {
      color: #f9fafb;
    }
    .x-embed-text {
      color: #d1d5db;
    }
    .x-embed-translation {
      border-top-color: #374151;
      color: #9ca3af;
    }
  }
</style>
