---

<div class="quote-collection">
  {quotes.map((q, index) => (
    <figure class="quote-card">
      <div class="quote-meta"><span>{String(index + 1).padStart(2, '0')} / {q.tag}</span><time>{q.date}</time></div>
      <blockquote lang="en">“{q.original}”</blockquote>
      <p class="translation">{q.translated}</p>
      <figcaption><strong>{q.voice}</strong><span>{q.role}</span></figcaption>
      <p class="quote-context">{q.context}</p>
      <a href={q.url} target="_blank" rel="noopener noreferrer" aria-label={`${q.voice} 인용 원문`}>인용 원문 ↗</a>
    </figure>
  ))}
</div>

<style>
  .quote-collection { display: grid; gap: .8rem; margin: 1.5rem 0 2rem; }
  .quote-card { margin: 0; padding: 1.05rem; border: 1px solid #e4e4dc; border-radius: 12px; background: #fffdf9; }
  .quote-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .4rem; color: #31796e; font-size: .7rem; font-weight: 700; letter-spacing: .04em; }
  .quote-card blockquote { margin: .75rem 0 .55rem; border: 0; padding: 0; font: 500 1.05rem/1.5 Georgia, serif; color: #252e2a; word-break: normal; }
  .quote-card .translation { font-size: .9rem; margin: 0 0 .8rem; line-height: 1.6; color: #454e49; }
  figcaption strong, figcaption span { display: block; }
  figcaption strong { font-size: .85rem; color: #252e2a; }
  figcaption span { font-size: .72rem; color: #65716d; margin-top: .15rem; }
  .quote-card .quote-context { margin: .85rem 0 .5rem; font-size: .78rem; color: #65716d; line-height: 1.7; }
  .quote-card a { font-size: .75rem; }
  @media (min-width: 660px) { .quote-collection { grid-template-columns: 1fr 1fr; } }
  @media (prefers-color-scheme: dark) {
    .quote-card { background: #17211e; border-color: #34443b; }
    .quote-card blockquote, figcaption strong { color: #f2ede4; }
    .quote-card .translation { color: #d5dcd7; }
    .quote-card .quote-context, figcaption span { color: #a8b4ab; }
    .quote-meta { color: #8ac7b7; }
  }
</style>
