---
import type { Lang } from '../../lib/seo';
import { researchCopy } from './copy';
interface Props { lang?: Lang; }
const { lang = 'ko' } = Astro.props;
const copy = researchCopy[lang];
const charts = [
  { version: copy.versions[0], date: '2026.10.27', name: 'aaii-v5-original', width: 1856, height: 878,
    alt: copy.benchmarkAlts[0],
    source: 'https://artificialanalysis.ai/articles/artificial-analysis-intelligence-index-v5' },
  { version: copy.versions[1], date: '2026.10.23', name: 'aaii-v4-original', width: 1856, height: 778,
    alt: copy.benchmarkAlts[1],
    source: 'https://artificialanalysis.ai/articles/kimi-k3-1-pro-launch-benchmarks' },
];
---

<div class="benchmark-comparison">
  {charts.map(c => (
    <figure>
      <figcaption><strong>{c.version}</strong><time>{c.date}</time></figcaption>
      <a href={`/articles/anthropic-s1-ipo/${c.name}.png`} target="_blank" rel="noopener noreferrer" aria-label={`${c.version} · ${copy.enlarge}`}>
        <img src={`/articles/anthropic-s1-ipo/${c.name}.png`} alt={c.alt} width={c.width} height={c.height} loading="lazy" decoding="async" />
      </a>
      <div class="chart-credit"><span>{copy.credit}</span><a href={c.source} target="_blank" rel="noopener noreferrer">{copy.source} ↗</a></div>
    </figure>
  ))}
</div>

<style>
  .benchmark-comparison { display: grid; gap: .9rem; margin: 1.5rem 0; }
  figure { margin: 0; overflow: hidden; border: 1px solid #dedfd8; border-radius: 10px; background: white; }
  figcaption { display: flex; justify-content: space-between; gap: .5rem; padding: .65rem .85rem; background: #f4f5ef; color: #28352f; font-size: .8rem; }
  img { display: block; width: 100%; height: auto; }
  .chart-credit { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .3rem; padding: .5rem .85rem; font-size: .68rem; color: #5e6862; }
  @media (prefers-color-scheme: dark) {
    figure { border-color: #47564e; }
    figcaption { background: #23362b; color: #edf2ea; }
  }
</style>
